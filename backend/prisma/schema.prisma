datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Publication {
  id                 Int              @id @default(autoincrement())
  contentHash        String           @unique
  title              String
  body               String
  authorAddress      String
  ipfsCid            String?
  consensusState     String           @default("PENDING")
  currentResult      String?
  currentRound       Int              @default(1)
  reopenRequestCount Int              @default(0)
  createdAt          DateTime         @default(now())
  validations        Validation[]
  reopenRequests     ReopenRequest[]
  rounds             Round[]
  favorites          Favorite[]
  follows            Follow[]
  tagLinks           PublicationTag[]

  @@map("publications")
}

// Etiquetas con persistencia propia (antes un array libre `tags String[]`
// directamente en Publication, sin constancia como entidad ni forma de
// consultarlas fuera de las publicaciones que las usan). Siguen siendo
// libres — cualquier autor escribe una nueva al publicar, sin catálogo
// cerrado — pero ahora cada etiqueta existe como fila propia y reutilizable,
// en vez de duplicarse como texto suelto en cada publicación que la usa.
model Tag {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  createdAt    DateTime         @default(now())
  publications PublicationTag[]

  @@map("tags")
}

// Tabla de unión N:M entre Publication y Tag.
model PublicationTag {
  contentHash String
  tagId       Int
  publication Publication @relation(fields: [contentHash], references: [contentHash])
  tag         Tag         @relation(fields: [tagId], references: [id])

  @@id([contentHash, tagId])
  @@map("publication_tags")
}

model Round {
  id          Int         @id @default(autoincrement())
  contentHash String
  round       Int
  state       String      @default("PENDING")
  result      String?
  completed   Boolean     @default(false)
  publication Publication @relation(fields: [contentHash], references: [contentHash])

  @@unique([contentHash, round])
  @@map("rounds")
}

model Validation {
  id               Int         @id @default(autoincrement())
  contentHash      String
  validatorAddress String
  vote             String // "TRUE" | "FALSE" | "UNVERIFIABLE"
  round            Int         @default(0)
  txHash           String?
  createdAt        DateTime    @default(now())
  publication      Publication @relation(fields: [contentHash], references: [contentHash])

  @@unique([contentHash, validatorAddress])
  @@map("validations")
}

model Validator {
  address         String   @id
  reputationScore Int      @default(0)
  lastSyncBlock   BigInt   @default(0)
  registeredAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("validators")
}

model ReopenRequest {
  id               Int         @id @default(autoincrement())
  contentHash      String
  requesterAddress String
  txHash           String?
  createdAt        DateTime    @default(now())
  publication      Publication @relation(fields: [contentHash], references: [contentHash])

  @@unique([contentHash, requesterAddress])
  @@map("reopen_requests")
}

model RetroactiveClaim {
  id               Int      @id @default(autoincrement())
  contentHash      String
  validatorAddress String
  netDelta         Int
  txHash           String?
  createdAt        DateTime @default(now())

  @@unique([contentHash, validatorAddress, txHash])
  @@map("retroactive_claims")
}

model UserProfile {
  address     String   @id
  displayName String?
  avatarUrl   String?
  email       String?
  updatedAt   DateTime @updatedAt

  @@map("user_profiles")
}

model Favorite {
  id          Int         @id @default(autoincrement())
  userAddress String
  contentHash String
  createdAt   DateTime    @default(now())
  publication Publication @relation(fields: [contentHash], references: [contentHash])

  @@unique([userAddress, contentHash])
  @@map("favorites")
}

model Follow {
  id          Int         @id @default(autoincrement())
  userAddress String
  contentHash String
  createdAt   DateTime    @default(now())
  publication Publication @relation(fields: [contentHash], references: [contentHash])

  @@unique([userAddress, contentHash])
  @@map("follows")
}

model Notification {
  id          Int      @id @default(autoincrement())
  userAddress String
  contentHash String
  type        String // "REOPENED" | "CONSENSUS_REACHED" | "RETROACTIVE_APPLIED"
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("notifications")
}

// Ledger de todos los cambios de reputación (evento ReputationUpdated),
// clasificados por origen correlacionando la transacción con el evento de
// ValidationRegistry que la disparó (ConsensusReached/RetroactiveClaimed/
// PredictionSubmitted) — ver indexer.ts, handleReputationUpdated. Sin FK a
// Publication (igual que Notification): contentHash es null para el
// registro inicial de un validador (REGISTERED), que no está ligado a
// ningún artículo.
model ReputationEvent {
  id          Int      @id @default(autoincrement())
  address     String
  delta       Int
  newScore    Int
  reason      String // "VOTE_REWARD" | "VOTE_PENALTY" | "PUBLISH_REWARD" | "PUBLISH_PENALTY" | "RETROACTIVE" | "PREDICTION_REWARD" | "PREDICTION_PENALTY" | "REGISTERED"
  contentHash String?
  round       Int?
  txHash      String?
  blockNumber BigInt
  createdAt   DateTime @default(now())

  @@index([address])
  @@map("reputation_events")
}

// Bookkeeping interno del indexador (no forma parte del catálogo de datos del
// ERS): persiste el último bloque procesado para que un reinicio del backend
// reanude en lugar de reprocesar el historial completo desde DEPLOY_BLOCK.
model IndexerState {
  id                 Int    @id @default(1)
  lastProcessedBlock BigInt @default(0)

  @@map("indexer_state")
}
