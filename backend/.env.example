DATABASE_URL=postgresql://newsera:newsera@localhost:5433/newsera
PORT=3001

# NETWORK=local usa RPC_URL_LOCAL (Hardhat Network en Docker); NETWORK=sepolia usa RPC_URL_SEPOLIA
NETWORK=local
RPC_URL_LOCAL=http://localhost:8545
RPC_URL_SEPOLIA=

PUBLICATION_REGISTRY_ADDRESS=
VALIDATION_REGISTRY_ADDRESS=
REPUTATION_SYSTEM_ADDRESS=

# Bloque de despliegue desde el que el indexador procesa el historico al arrancar
DEPLOY_BLOCK=0

# Token de servicio para POST /api/v1/sync/events (uso interno, no expuesto en el cliente)
SERVICE_TOKEN=dev-service-token
